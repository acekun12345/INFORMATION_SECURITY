# Local development defaults to an isolated browser demo; no Firebase writes.
VITE_QUEUE_MODE=demo
# To test Firebase locally, set VITE_QUEUE_MODE=firebase. The existing CCDI
# Firebase web configuration is prefilled in src/firebase.ts; optional values
# below can override it. These are public client settings, not database rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Default: isolated browser demo; no Firebase writes.
VITE_QUEUE_MODE=demo
# To use your existing Firebase database, copy this to .env.local, fill these
# values, then change mode to firebase. See README before enabling live mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
